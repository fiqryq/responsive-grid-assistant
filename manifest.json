{
  "manifest_version": 3,
  "name": "Responsive Grid Assistant",
  "version": "1.0.0",
  "description": "Chrome extension for assisting responsive design with customizable grid overlays",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Responsive Grid Assistant"
  },
  "commands": {
    "toggle-grid": {
      "suggested_key": {
        "default": "Ctrl+Shift+G"
      },
      "description": "Toggle grid overlay"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}